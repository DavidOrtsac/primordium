{
  "name": "squirm3-pro",
  "version": "2.0.0",
  "description": "Primordium — Squirm3-based artificial life with microbe-steering game mode, surface-tension water physics, and WebGPU rendering.",
  "author": "David Castro",
  "license": "GPL-3.0-or-later",
  "homepage": "https://github.com/timhutton/squirm3",
  "contributors": [
    "Tim Hutton (original Squirm3, 2007)"
  ],
  "scripts": {
    "build": "esbuild src/main.ts --bundle --outfile=dist/bundle.js && esbuild src/physics-worker.ts --bundle --outfile=dist/worker.js",
    "dev": "esbuild src/main.ts --bundle --outfile=dist/bundle.js --watch & esbuild src/physics-worker.ts --bundle --outfile=dist/worker.js --watch"
  },
  "devDependencies": {
    "@webgpu/types": "^0.1.69",
    "esbuild": "^0.28.0",
    "typescript": "^6.0.3"
  }
}
